PORT=4000
# Local Mongo:
MONGO_URI=mongodb://localhost:27017/lao_coverage
# Or MongoDB Atlas — get this from Atlas > Connect > Drivers, add a db name after the host:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lao_coverage?retryWrites=true&w=majority&appName=<AppName>
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173
AGGREGATION_CRON=*/15 * * * *
