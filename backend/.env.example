PORT=4000
# Local Mongo:
MONGO_URI=mongodb://localhost:27017/lao_coverage
# Or MongoDB Atlas — get this from Atlas > Connect > Drivers, add a db name after the host:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lao_coverage?retryWrites=true&w=majority&appName=<AppName>
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
AGGREGATION_CRON=*/15 * * * *
# Full-country coverage prediction (MODEL step infill) — heavier job, runs
# far less often than the real-data aggregation above.
PREDICTION_CRON=0 3 * * *

# AI-assisted recommendation reasoning (MODEL step: blends signal data with
# the population proxy to explain why an area is flagged as underserved).
# Optional — leave blank to fall back to the plain scoring formula.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
